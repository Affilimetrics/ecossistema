# Django / aplicação principal
SECRET_KEY=gere-uma-chave-segura
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=America/Sao_Paulo
# Opcional; sem esta variável o projeto usa SQLite local.
DATABASE_URL=
DESKTOP_API_SIGNING_KEY=
DESKTOP_API_TOKEN_MAX_AGE=2592000

# Criptografia já usada pelo ecossistema para credenciais de canais.
CREDENTIAL_ENCRYPTION_KEY=gere-uma-chave-secreta-propria

# Tráfego Pago / Meta Ads
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_REDIRECT_URI=http://127.0.0.1:8000/trafego-pago/auth/meta/callback/
META_SCOPES=ads_read,business_management,pages_show_list,pages_read_engagement,instagram_basic
META_APPSECRET_PROOF=True
# Chave Fernet exclusiva para tokens Meta; não reutilize SECRET_KEY nem CREDENTIAL_ENCRYPTION_KEY.
TOKEN_ENCRYPTION_KEY=

# Intervalo padrão do comando de manutenção analítica LTV (segundos)
AUTOMATION_INTERVAL_SECONDS=900

# ROI Manager: diretório local monitorado pela automação CSV (opcional)
ROI_INBOX_DIR=data/inbox

# Mercado Livre — token global opcional; credenciais individuais são criptografadas no banco.
ML_ACCESS_TOKEN=
ML_SITE_ID=MLB
ML_AFFILIATE_ID=
ML_REQUEST_TIMEOUT=20
